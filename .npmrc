# Supply-chain hardening for the root package (newman, used by the API
# end-to-end CI job). Mirrors auth_service/.npmrc and docs/.npmrc.

# Hold off on versions published in the last 7 days. A freshly published
# malicious release is the usual shape of an npm account takeover, and this
# window gives it time to be caught before it reaches a build.
minimum-release-age=10080

# Block dependency lifecycle scripts (postinstall etc.) by default.
ignore-scripts=true

# Pin exact versions on install; no silent minor drift on a lockfile refresh.
save-exact=true
