{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/docs/security",
      "destination": "/docs/security/overview",
      "permanent": true
    },
    {
      "source": "/apis/ui_warning",
      "destination": "/apis/auth_service",
      "permanent": true
    }
  ]
}
