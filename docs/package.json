{
  "name": "docs",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "type": "module",
  "scripts": {
    "build": "pnpm run diagrams && pnpm run check:types && vocs build && node ./scripts/inject-seo-head.mjs && node ./scripts/generate-seo-files.mjs && node ./scripts/check-sitemap.mjs && node ./scripts/check-page-weight.mjs",
    "dev": "vocs dev",
    "diagrams": "./diagrams/gen.sh",
    "preview": "vocs preview",
    "install:d2": "./scripts/install-d2.sh",
    "check:types": "tsc --noEmit",
    "seo": "node ./scripts/generate-seo-files.mjs",
    "check:sitemap": "node ./scripts/check-sitemap.mjs",
    "check:weight": "node ./scripts/check-page-weight.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vocs": "2.7.2",
    "waku": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "5.9.3",
    "vite": "8.1.5"
  }
}
