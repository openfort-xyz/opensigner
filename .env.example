# OpenSigner — environment template. Copy to `.env` and fill in every value.
#
# Variables marked REQUIRED have no default: docker-compose fails to start
# without them, deliberately, so a deployment cannot silently come up with weak
# credentials. Generate every secret with a CSPRNG -- never reuse these samples.

# ---------------------------------------------------------------------------
# REQUIRED secrets
# ---------------------------------------------------------------------------

# Application secret for auth_service (better-auth). Signs session cookies and
# encrypts the JWKS private signing key at rest. Minimum 32 characters; the
# service refuses to start on a weak or default value.
#   openssl rand -base64 48
#
# ROTATION: this secret encrypts the signing key held in the `jwks` table, so
# changing it requires `DELETE FROM jwks;` (the service regenerates a key) followed
# by `DELETE FROM session;`. Without that, token issuance fails with "Failed to
# decrypt private key". Treat the previous signing key as exposed whenever the
# secret protecting it may have been.
JWT_SECRET=

# AES-256-GCM key encrypting hot shares at rest. Exactly 64 hex characters.
#   openssl rand -hex 32
SHARE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# REQUIRED database credentials
# ---------------------------------------------------------------------------
# Set this BEFORE first start: Postgres bakes the password in at volume
# initialisation, so changing it later requires ALTER USER or a fresh volume.
# Hex, not base64: these values are interpolated into postgres:// URLs, where
# base64's +, / and = would corrupt the DSN.
#   openssl rand -hex 32

POSTGRES_PASSWORD=

# Per-service DB credentials. All three services connect to Postgres, so these
# typically hold the same value as POSTGRES_PASSWORD.
AUTH_SERVICE_DB_PASS=
HOT_STORAGE_DB_PASS=
COLD_STORAGE_DB_PASS=

# ---------------------------------------------------------------------------
# Optional — defaults shown
# ---------------------------------------------------------------------------

# auth_service's externally visible base URL. Two things key off this:
#   - the `iss` and `aud` claims on issued JWTs
#   - whether session cookies get the Secure flag (https:// => Secure)
# Use https:// in production, or cookies are issued without Secure.
# BETTER_AUTH_BASE_URL=http://localhost:7052

# Origins allowed to embed the iframe and call the APIs (comma-separated).
# ALLOWED_ORIGINS=http://localhost:7050,http://localhost:7051

# Set to true only when exactly one reverse proxy fronts auth_service. Rate
# limiting then keys on the address the proxy saw; left false, every caller
# behind a proxy shares the proxy's own rate-limit budget.
# TRUST_PROXY=false

# Internal address hot_storage uses to FETCH the JWKS. Must be https unless
# ALLOW_INSECURE_AUTH_SERVER=true, since an attacker who can rewrite this
# channel can substitute the key set and forge tokens for any user.
# AUTH_SERVER_URL=http://authservice:3000

# Hosts that Shield (cold storage) lets custom-provider JWK URLs point to even
# though they are internal or plain HTTP. Defaults to the bundled auth service;
# anything else must be https on a public host.
# COLD_STORAGE_JWK_ALLOWED_HOSTS=authservice:3000

# Expected JWT iss/aud enforced by hot_storage. These are auth_service's
# EXTERNAL base URL and therefore differ from AUTH_SERVER_URL above; they
# default to BETTER_AUTH_BASE_URL.
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=

# OAuth client ID accepted for `x-auth-provider: google`. Leave unset to reject
# that provider. If unset, hot_storage refuses Google tokens rather than
# accepting any Google-signed ID token regardless of which client it was for.
# GOOGLE_JWT_AUDIENCE=

# Local development only. Permits fetching the JWKS over plaintext HTTP.
# Never enable in production.
# ALLOW_INSECURE_AUTH_SERVER=false

# TLS mode for database connections. Note docker-compose.dev.yml overrides this
# to `disable` for local runs, so `make run` does not exercise DB TLS.
# AUTH_SERVICE_DB_SSLMODE=require
# HOT_STORAGE_DB_SSLMODE=require
# COLD_STORAGE_DB_SSLMODE=require

# Host port mappings.
# IFRAME_HOST_PORT=7050
# IFRAME_SAMPLE_HOST_PORT=7051
# AUTH_SERVICE_HOST_PORT=7052
# COLD_STORAGE_HOST_PORT=7053
# HOT_STORAGE_HOST_PORT=7054
# DOCS_HOST_PORT=7055

# GitHub Packages token, only needed to build the docs image.
# NODE_AUTH_TOKEN=
